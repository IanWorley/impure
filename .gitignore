# Original game files and local analysis artifacts.
# No trailing slash, so a symlink to a directory elsewhere is ignored too.
/originals
/local
/build/
/runtime/target/
# Release archives from tools/package-release.sh.
/dist/
__pycache__/

# Game files are never committed, wherever they end up.
*.iso
*.7z
*.xex
*.xexp
*.bik
*.xma
*.xwb
*.xsb
*.xgs
# The game library the runtime builds, if one is ever copied here.
pure_game.*
