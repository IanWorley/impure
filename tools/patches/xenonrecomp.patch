+++ b/XenonUtils/ppc_context.h
@@ -31,20 +31,29 @@
 
 #define PPC_FUNC_PROLOGUE() __builtin_assume(((size_t)base & 0x1F) == 0)
 
+// The Xbox 360 shows physical memory through three views; the 4 KiB-page one (0xE0000000 up) is
+// offset by one 4 KiB page. A host whose pages are larger (Apple silicon's 16 KiB, Windows' 64 KiB
+// mapping granularity) cannot map memory at that offset, so the view cannot alias the others and
+// a byte written through one view would not be seen through another. Every access through it
+// goes instead to the 64 KiB-page view of the same physical byte (0xA0000000 + physical).
+#ifndef PPC_MEMORY_ADDRESS
+#define PPC_MEMORY_ADDRESS(x) (uint32_t(x) >= 0xE0000000u ? uint32_t(x) - 0x3FFFF000u : uint32_t(x))
+#endif
+
 #ifndef PPC_LOAD_U8
-#define PPC_LOAD_U8(x) *(volatile uint8_t*)(base + (x))
+#define PPC_LOAD_U8(x) *(volatile uint8_t*)(base + PPC_MEMORY_ADDRESS(x))
 #endif
 
 #ifndef PPC_LOAD_U16
-#define PPC_LOAD_U16(x) __builtin_bswap16(*(volatile uint16_t*)(base + (x)))
+#define PPC_LOAD_U16(x) __builtin_bswap16(*(volatile uint16_t*)(base + PPC_MEMORY_ADDRESS(x)))
 #endif
 
